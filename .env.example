# SOLESHIFT — Firebase Authentication & Client Configuration
# Get these values from your Firebase Project Console -> Project Settings -> General -> Your apps -> Web app
# NOTE: Firebase configuration identifies your client project. Security rules, authorized domains,
# and Authentication settings in the Firebase Console govern actual backend access.

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
